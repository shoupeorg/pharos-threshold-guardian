{
  "name": "pharos-threshold-guardian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A reusable Pharos Skill and web guardian that evaluates three live on-chain thresholds through Chain MCP.",
  "scripts": {
    "build": "esbuild ./src/worker.js --bundle --format=esm --platform=browser --target=es2022 --outfile=worker.js",
    "check": "node --test",
    "demo": "node ./scripts/invoke-skill.mjs",
    "deploy": "npm run build && wrangler deploy --no-bundle",
    "dev": "npm run build && wrangler dev",
    "login": "wrangler login",
    "mcp:probe": "node ./scripts/probe-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "wrangler": "4.92.0"
  }
}
